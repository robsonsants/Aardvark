# Modelo de configuração — COPIE para `.env` e preencha com seus tokens reais.
# O `.env` real NÃO deve ser versionado nem compartilhado (está no .gitignore).
# Este arquivo (.env.example) SIM pode ser versionado: contém só placeholders.

# Token de acesso pessoal do GitHub (escopo: public_repo / read).
# Gere em: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave da API do NVD (opcional, mas recomendada: acelera a mineração da Fase 1
# e reduz erros 503). Solicite em: https://nvd.nist.gov/developers/request-an-api-key
NVD_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
